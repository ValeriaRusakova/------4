# Copy this file to ".env" and put your real values there.
# The real .env file is secret and is NOT uploaded to GitHub.

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=chatgpt_db

# Address of the React site (allowed by CORS)
FRONTEND_URL=http://localhost:5173
