{
  "info": {
    "name": "ValGPT API",
    "description": "Tests for the ValGPT chat server. Run the requests in order (top to bottom). The server must be running on http://localhost:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "conversationId", "value": "" },
    { "key": "secondConversationId", "value": "" },
    { "key": "imageUrl", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health check",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Server and DB are OK', () => {",
        "    const body = pm.response.json();",
        "    pm.expect(body.status).to.eql('ok');",
        "    pm.expect(body.database).to.eql('connected');",
        "});"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
    },
    {
      "name": "2. Create conversation",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));",
        "const body = pm.response.json();",
        "pm.test('Has numeric id', () => pm.expect(body.id).to.be.a('number'));",
        "pm.collectionVariables.set('conversationId', body.id);"
      ] } }],
      "request": { "method": "POST", "url": "{{baseUrl}}/api/conversations" }
    },
    {
      "name": "3. Send message",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));",
        "const body = pm.response.json();",
        "pm.test('User message saved', () => pm.expect(body.user_message.role).to.eql('user'));",
        "pm.test('Assistant answered', () => {",
        "    pm.expect(body.assistant_message.role).to.eql('assistant');",
        "    pm.expect(body.assistant_message.content.toLowerCase()).to.include('paris');",
        "});",
        "pm.test('Conversation got a topic title', () => {",
        "    pm.expect(body.conversation.title).to.be.a('string').and.not.be.empty;",
        "});",
        "pm.test('No image for a normal question', () => pm.expect(body.assistant_message.image_url).to.eql(null));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"What is the capital of France? Answer in English.\"\n}" },
        "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages"
      }
    },
    {
      "name": "4. Send follow-up message (context)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));",
        "pm.test('Model understood the context (Rome)', () => {",
        "    const answer = pm.response.json().assistant_message.content.toLowerCase();",
        "    pm.expect(answer).to.include('rome');",
        "});"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"And what about Italy?\"\n}" },
        "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages"
      }
    },
    {
      "name": "5. Get conversation history",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const messages = pm.response.json();",
        "pm.test('4 messages saved', () => pm.expect(messages.length).to.eql(4));",
        "pm.test('Roles alternate user/assistant', () => {",
        "    pm.expect(messages.map(m => m.role)).to.eql(['user', 'assistant', 'user', 'assistant']);",
        "});",
        "pm.test('Messages are in chronological order', () => {",
        "    for (let i = 1; i < messages.length; i++) {",
        "        pm.expect(messages[i].id).to.be.above(messages[i - 1].id);",
        "    }",
        "});"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages" }
    },
    {
      "name": "5b. List conversations (sidebar)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const list = pm.response.json();",
        "pm.test('Newest conversation is first, with a title', () => {",
        "    pm.expect(list[0].id).to.eql(Number(pm.collectionVariables.get('conversationId')));",
        "    pm.expect(list[0].title).to.be.a('string').and.not.be.empty;",
        "});",
        "pm.test('Sorted by last activity (newest first)', () => {",
        "    for (let i = 1; i < list.length; i++) {",
        "        pm.expect(new Date(list[i - 1].updated_at) >= new Date(list[i].updated_at)).to.be.true;",
        "    }",
        "});"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/conversations" }
    },
    {
      "name": "6. New conversation is separate",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));",
        "const body = pm.response.json();",
        "pm.test('Got a different id', () => pm.expect(body.id).to.not.eql(Number(pm.collectionVariables.get('conversationId'))));",
        "pm.collectionVariables.set('secondConversationId', body.id);"
      ] } }],
      "request": { "method": "POST", "url": "{{baseUrl}}/api/conversations" }
    },
    {
      "name": "7. New conversation history is empty",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('No messages from the other conversation', () => pm.expect(pm.response.json()).to.eql([]));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/conversations/{{secondConversationId}}/messages" }
    },
    {
      "name": "8. Generate image (AI tool)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));",
        "const body = pm.response.json();",
        "pm.test('The AI created an image', () => {",
        "    pm.expect(body.assistant_message.image_url).to.match(/^\\/images\\/.+\\.webp$/);",
        "});",
        "pm.collectionVariables.set('imageUrl', body.assistant_message.image_url);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"Please draw a simple picture of a red apple.\"\n}" },
        "url": "{{baseUrl}}/api/conversations/{{secondConversationId}}/messages"
      }
    },
    {
      "name": "9. Image file is served",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('It is a webp image', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image/webp'));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}{{imageUrl}}" }
    },
    {
      "name": "10. Web search (up-to-date information)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));",
        "pm.test('The answer includes a link to a source', () => {",
        "    pm.expect(pm.response.json().assistant_message.content).to.include('http');",
        "});"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"What will the weather be tomorrow in Tel Aviv? Answer in English.\"\n}" },
        "url": "{{baseUrl}}/api/conversations/{{secondConversationId}}/messages"
      }
    },
    {
      "name": "11. Delete conversation",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 204 (deleted, no content)', () => pm.response.to.have.status(204));"
      ] } }],
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/conversations/{{secondConversationId}}" }
    },
    {
      "name": "12. Deleted conversation is gone",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 404', () => pm.response.to.have.status(404));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/conversations/{{secondConversationId}}/messages" }
    },
    {
      "name": "13. Deleted image file is gone",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 404', () => pm.response.to.have.status(404));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}{{imageUrl}}" }
    },
    {
      "name": "14. Other conversation was not deleted",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Still has its 4 messages', () => pm.expect(pm.response.json().length).to.eql(4));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages" }
    },
    {
      "name": "Error: conversation not found (404)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 404', () => pm.response.to.have.status(404));",
        "pm.test('Has error message', () => pm.expect(pm.response.json().detail).to.be.a('string'));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/conversations/999999/messages" }
    },
    {
      "name": "Error: empty message (422)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 422', () => pm.response.to.have.status(422));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"   \"\n}" },
        "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages"
      }
    },
    {
      "name": "Error: missing content field (422)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 422', () => pm.response.to.have.status(422));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages"
      }
    },
    {
      "name": "Error: send to missing conversation (404)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 404', () => pm.response.to.have.status(404));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"hello\"\n}" },
        "url": "{{baseUrl}}/api/conversations/999999/messages"
      }
    },
    {
      "name": "Error: delete missing conversation (404)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 404', () => pm.response.to.have.status(404));"
      ] } }],
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/conversations/999999" }
    }
  ]
}
